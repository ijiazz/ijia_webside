{
  "nodeModulesDir": "manual",
  "tasks": {
    "check-type": "deno check src",
    "dev": "deno x vite",
    "preview": "deno x vite preview",
    "build": "deno x vite build",
    "build:ssr": "deno x vite build --outDir dist/server --ssr src/index-server.tsx",
  },
  "imports": {
    "@ant-design/icons": "npm:@ant-design/icons@^6.1.0",
    "@asla/hofetch": "jsr:@asla/hofetch@^0.0.1",
    "@asla/wokao": "jsr:@asla/wokao@^0.0.3",
    "@emotion/css": "npm:@emotion/css@^11.13.5",
    "@microsoft/clarity": "npm:@microsoft/clarity@^1.0.0",
    "@sentry/react": "npm:@sentry/react@^10.51.0",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.90.20",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.157.7",
    "@uifx/infinite-wall": "npm:@uifx/infinite-wall@^0.0.2",
    "animejs": "npm:animejs@^4.2.2",

    "antd": "npm:antd@^6.2.1",
    "canvas-confetti": "npm:canvas-confetti@^1.9.3",
    "cropperjs": "npm:cropperjs@^1.6.2",
    "dayjs": "npm:dayjs@^1.11.13",
    "evlib": "jsr:@asn/evlib@^3.1.3",
    "fireworks-js": "npm:fireworks-js@^2.10.8",
    "react": "npm:react@^19.2.3",
    "react-cropper": "npm:react-cropper@^2.3.3",
    "react-dom": "npm:react-dom@^19.2.3",
    "react-hook-form": "npm:react-hook-form@^7.71.1",

    //dev

    "@/": "./src/",
    "vite": "npm:vite@^8.0.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@tanstack/router-plugin": "npm:@tanstack/router-plugin@^1.157.7",
    "@vitejs/plugin-legacy": "npm:@vitejs/plugin-legacy@^8.0.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.1",
    "@sentry/vite-plugin": "npm:@sentry/vite-plugin@^5.2.1",
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "skipLibCheck": true,
    "types": ["npm:@types/canvas-confetti@^1.9.0", "npm:@types/react@^19.2.8", "npm:@types/react-dom@^19.2.3"],
  },
  "links": ["../web_dto"],
  "allowScripts": ["npm:core-js@3.49.0"],
}
