FROM denoland/deno:alpine-2.9.4 AS web-api
ENV DENO_DIR="/deno-dir"
WORKDIR /serve

ADD ./web_dto/deno.json ./web_dto/deno.lock ./web_dto/
ADD ./web_api/deno.jsonc ./web_api/deno.lock ./web_api/config.jsonc ./web_api/
RUN --mount=type=cache,id=deno-cache-web-api,target=/deno-dir cd web_dto && deno install && cd ../web_api && deno install

ADD ./web_dto/src ./web_dto/src
ADD ./web_api/src ./web_api/src

WORKDIR /serve/web_api
EXPOSE 3000

ENV DATABASE_URL="postgresql://ijia_web@localhost:5432/ijia"
ENV OSS_ROOT_DIR="./store/oss"
ENV LISTEN="0.0.0.0:3000"
ENV CHECK_SERVER="localhost:9000"

CMD ["deno", "run", "-A", "--no-lock", "--config", "deno.jsonc", "--env", "src/main.ts"] 
