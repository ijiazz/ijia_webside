{
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npm.org"
  },
  "scripts": {
    "init-api-types": "pnpm run --filter @ijia/api-types build",
    "check-type": "pnpm run -r check-type",
    "check-fmt": "oxfmt --check web_api web e2e",
    "fmt": "oxfmt web_api web e2e"
  },
  "devDependencies": {
    "@ijia/school-db": "catalog:",
    "oxfmt": "^0.60.0",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.1.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "download"
    }
  }
}
