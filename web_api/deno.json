{
  "nodeModulesDir": "manual",
  "tasks": {
    "start": "deno run -A --no-lock -c deno.json --env src/main.ts",
    "recreate-db": "deno eval 'await import(\"@ijia/school-db/testlib\").then((mod) => mod.createInitIjiaDbForTest())'",
    "start:e2e": "MODE=E2E deno run -A --no-lock -c deno.json --env src/main.ts",
    "cmd": "deno run -A --env scripts/get.ts",
    "check-type": "deno check src test"
  },
  "fmt": {
    "lineWidth": 120
  },
  "imports": {
    "@/": "./src/"
  },
  "compilerOptions": {}
}
