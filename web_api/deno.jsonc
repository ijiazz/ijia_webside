{
  "nodeModulesDir": "manual",
  "tasks": {
    "start": "deno run -A --no-lock --env src/main.ts",
    "start:e2e": "MODE=E2E deno run -A --no-lock --env src/main.ts",
    "cmd": "deno run -A --env scripts/get.ts",
    "check-type": "deno check src test",
    "gen-buildMeta": {
      "description": "生成版本元数据",
      "command": "deno run -A scripts/write_version_meta.ts",
    },
    "test": "deno x vitest run",
  },
  "test": {
    "include": [],
  },
  "buildMeta": {
    "commitSha": "dev",
    "commitDate": "",
  },
  "fmt": {
    "lineWidth": 120,
  },
  "imports": {
    "@asla/pg": "jsr:@asla/pg@^0.2.4",
    "@asla/hofetch": "jsr:@asla/hofetch@^0.0.2",
    "@asla/wokao": "jsr:@asla/wokao@^0.0.3",
    "@asla/yoursql": "jsr:@asla/yoursql@0.14.0",
    "@ijia/school-db": "jsr:@ijia/school-db@^0.0.4",
    "@redis/client": "npm:@redis/client@^6.1.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "evlib": "npm:evlib@^3.1.3",
    "hono": "npm:hono@^4.12.31",
    "nodemailer": "npm:nodemailer@^9.0.3",
    // dev
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@/": "./src/",
    "#test/": "./test/",
    "vitest": "npm:vitest@^4.1.10",
  },
  "jsrDepsInNodeModules": true,
  "compilerOptions": {
    "types": ["npm:@types/nodemailer@^8.0.1"],
  },
  "links": ["../web_dto"],
}
