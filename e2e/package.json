{
  "type": "module",
  "scripts": {
    "e2e:local": "playwright test --ui",
    "check-type": "deno check",
    "install-browsers": "playwright install chromium webkit firefox",
    "install-browser": "pnpm dlx @puppeteer/browsers install chrome@109",
    "e2e:ci": "playwright test --trace retain-on-first-failure --retries=1",
    "e2e:bench": "playwright test -c playwright.bench.config.ts",
    "codegen": "playwright codegen --channel msedge",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@asla/hofetch": "jsr:@asla/hofetch@^0.0.2",
    "@asla/pg": "jsr:@asla/pg@^0.2.4",
    "@asla/yoursql": "jsr:@asla/yoursql@0.14.0",
    "@ijia/school-db": "jsr:@ijia/school-db@^0.0.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.1",
    "evlib": "jsr:@asn/evlib@^3.1.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  }
}
